# Required Alpha Vantage API key (free tier at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Optional overrides
PORT=3015
PYTHON_BIN=python

# Set MOCK=1 to serve synthetic news instead of calling Alpha Vantage.
# Useful for exercising the UI without an API key or without burning quota.
MOCK=0